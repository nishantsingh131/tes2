ErrorDocument 404 /404.php

RewriteEngine On
RewriteCond %{HTTP_HOST} ^(?:www\.)?fullmocktestseries\.in$ [NC]
RewriteRule ^ https://fullmocktestseries.com%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.fullmocktestseries\.com$ [NC]
RewriteRule ^ https://fullmocktestseries.com%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^(?:index|banking-test-series)\.php$ / [R=301,L,NC]